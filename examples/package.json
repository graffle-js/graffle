{
  "name": "examples",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest --config vitest.config.ts",
    "check:types": "tsc --noEmit",
    "gen": "pnpm gen:graffle",
    "gen:graffle": "rm -rf ./$/graffle && pnpm graffle --defaultSchemaUrl http://localhost:3000/graphql --schema ../tests/_/fixtures/schemas/pokemon/schema.graphql --output ./$/graffle",
    "gen:types": "vitest --run --bail=1 --testNamePattern '^---NO-TESTS-MATCH-THIS---$'"
  },
  "dependencies": {
    "@opentelemetry/sdk-trace-base": "^2.2.0",
    "@opentelemetry/sdk-trace-node": "^2.2.0",
    "graphql": "^16.12.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@effect/platform": "^0.93.7",
    "@effect/platform-node": "^0.103.0",
    "@tsconfig/node20": "^20.1.8",
    "@tsconfig/strictest": "^2.0.8",
    "@wollybeard/kit": "^0.105.0",
    "effect": "^3.19.11",
    "graffle": "workspace:*",
    "tsx": "^4.21.0",
    "vitest": "^4.0.15"
  }
}
